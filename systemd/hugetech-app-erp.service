[Unit]
Description=ERP Hugetech
After=network-online.target postgresql.service
Wants=network-online.target
# Pornește doar cu variabilele obligatorii completate în panou și cu o versiune construită (altfel nu încearcă deloc).
ConditionPathExists=/etc/hugetech-aplicatii/erp.gata
ConditionPathExists=/var/lib/hugetech-aplicatii/erp.construit
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/node /opt/hugetech-server/aplicatii.mjs porneste erp
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=20
MemoryMax=3G
SyslogIdentifier=hugetech-app-erp

[Install]
WantedBy=multi-user.target
